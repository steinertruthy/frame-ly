{
  "name": "framely-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "releases": "node scripts/fetch-releases.mjs",
    "build": "node scripts/fetch-releases.mjs && astro build",
    "build:offline": "astro build",
    "preview": "astro preview",
    "lint": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "astro": "7.4.4",
    "@astrojs/sitemap": "3.7.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
