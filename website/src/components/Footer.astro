---
import LogoMark from './LogoMark.astro';
import { type Locale } from '../i18n/locales';
import { fill, t } from '../i18n';
import { pageHref, REPO_URL } from '../lib/paths';

interface Props {
  locale: Locale;
  year: number;
}
const { locale, year } = Astro.props;
const m = t(locale);
const f = m.footer;
const cols = [
  {
    title: f.product,
    links: [
      { href: pageHref('home', locale, '#features'), label: m.nav.features },
      { href: pageHref('home', locale, '#ai'), label: m.nav.ai },
      { href: pageHref('home', locale, '#download'), label: m.nav.download },
      { href: pageHref('changelog', locale), label: f.changelog },
    ],
  },
  {
    title: f.resources,
    links: [
      { href: REPO_URL, label: f.github },
      { href: `${REPO_URL}/releases`, label: f.releases },
      { href: `${REPO_URL}/issues`, label: f.issues },
      { href: pageHref('faq', locale), label: f.faq },
    ],
  },
  {
    title: f.legal,
    links: [
      { href: pageHref('privacy', locale), label: f.privacy },
      { href: pageHref('terms', locale), label: f.terms },
      { href: pageHref('license', locale), label: f.license },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={pageHref('home', locale)} aria-label={m.a11y.home}>
          <LogoMark size={30} /><span>FrameLy</span>
        </a>
        <p>{f.tagline}</p>
      </div>
      {
        cols.map((c) => (
          <nav aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="bottom">
      <p>{fill(f.rights, { year })}</p>
      <p class="tm">{f.trademarks}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding: 72px 0 40px;
    background: linear-gradient(180deg, transparent, rgba(10, 16, 32, 0.6));
  }
  .top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 18px;
  }
  .about p {
    margin-top: 16px;
    color: var(--text-2);
    font-size: 15px;
    max-width: 34ch;
  }
  h2 {
    font-size: 13px;
    font-family: var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    font-weight: 600;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    display: grid;
    gap: 9px;
  }
  ul a {
    color: var(--text-2);
    font-size: 15px;
  }
  ul a:hover {
    color: var(--text);
  }
  .bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: 8px;
    color: var(--text-3);
    font-size: 13px;
  }
  .tm {
    font-size: 12px;
  }
  @media (max-width: 820px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
