---
import Icon from './Icon.astro';
import { t } from '../i18n';
import type { Locale } from '../i18n/locales';
import { pageHref } from '../lib/paths';

interface Props {
  locale: Locale;
  /** On the home page: a heading and a link to the full page. */
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const m = t(locale);
const items = compact ? m.faq.items.slice(0, 6) : m.faq.items;
---

<div class="faq">
  {
    items.map((it) => (
      <details>
        <summary>
          <span>{it.q}</span>
          <Icon name="chevron" size={18} class="chev" />
        </summary>
        <p>{it.a}</p>
      </details>
    ))
  }
  {
    compact && (
      <a class="more" href={pageHref('faq', locale)}>
        {m.faq.more}
        <Icon name="arrow" size={16} />
      </a>
    )
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--hairline);
  }
  details {
    border-bottom: 1px solid var(--hairline);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 2px;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 18.5px;
    font-weight: 560;
    letter-spacing: -0.012em;
    color: var(--text);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(.chev) {
    flex: none;
    color: var(--text-3);
    transition: transform 260ms var(--ease);
  }
  details[open] summary :global(.chev) {
    transform: rotate(180deg);
  }
  details p {
    padding: 0 40px 24px 2px;
    color: var(--text-2);
    max-width: 72ch;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 15px;
  }
</style>
