---
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import { t } from '../i18n';
import type { Locale } from '../i18n/locales';
import type { ShotName } from '../lib/shots';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = t(locale);
const it = m.features.items;
const rows: { key: keyof typeof it; icon: string; shot: ShotName; inset?: ShotName }[] = [
  { key: 'screenshot', icon: 'camera', shot: 'editor' },
  { key: 'recording', icon: 'video', shot: 'home', inset: 'recbar' },
  { key: 'transcription', icon: 'wave', shot: 'transcript' },
  { key: 'summaries', icon: 'doc', shot: 'summary' },
  { key: 'topics', icon: 'tree', shot: 'topics' },
];
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>{m.features.eyebrow}</p>
      <h2 id="features-title" class="section-title" data-reveal>{m.features.title}</h2>
    </div>
    <div class="rows">
      {
        rows.map((r, i) => {
          const f = it[r.key];
          return (
            <article class:list={['row', i % 2 === 1 && 'flip']} id={`feature-${r.key}`} aria-labelledby={`f-${r.key}`}>
              <div class="copy" data-reveal>
                <p class="kicker">
                  <Icon name={r.icon} size={16} />
                  {f.kicker}
                </p>
                <h3 id={`f-${r.key}`}>{f.title}</h3>
                <p class="body">{f.body}</p>
                <div class="benefit">
                  <span class="label">{m.features.benefit}</span>
                  <p>{f.benefit}</p>
                </div>
              </div>
              <div class="media" data-reveal style="--delay: 120ms">
                <Shot locale={locale} name={r.shot} alt={f.alt} sizes="(max-width: 900px) 94vw, 700px" />
                {r.inset && (
                  <div class="inset">
                    <Shot locale={locale} name={r.inset} alt="" sizes="320px" framed={false} />
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .rows {
    display: grid;
    gap: clamp(96px, 12vw, 160px);
  }
  .row {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
  }
  .row.flip .copy {
    order: 2;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--blue-200);
    font-size: 14px;
    font-weight: 600;
  }
  h3 {
    margin-top: 16px;
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.028em;
  }
  .body {
    margin-top: 18px;
    color: var(--text-2);
  }
  .benefit {
    margin-top: 28px;
    padding: 16px 0 0;
    border-top: 1px solid var(--hairline);
  }
  .label {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    font-weight: 600;
  }
  .benefit p {
    margin-top: 6px;
    color: var(--text);
    font-size: 16px;
  }
  .media {
    position: relative;
  }
  .media::before {
    content: '';
    position: absolute;
    inset: 10% 6%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(58, 111, 224, 0.22), transparent 70%);
    filter: blur(36px);
    z-index: -1;
  }
  .inset {
    position: absolute;
    width: 46%;
    left: 50%;
    bottom: -7%;
    transform: translateX(-50%);
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.6));
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row.flip .copy {
      order: 0;
    }
    .inset {
      width: 64%;
    }
  }
</style>
