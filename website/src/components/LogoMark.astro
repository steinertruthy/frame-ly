---
/** The app's mark (assets/logo.svg), simplified for small sizes. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
// Identical definitions everywhere, so repeating the ids on one page is harmless.
const id = "lm";
---

<svg width={size} height={size} viewBox="100 100 824 824" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2148A8" /><stop offset="0.5" stop-color="#0F2259" /><stop offset="1" stop-color="#060D26" />
    </linearGradient>
    <radialGradient id={`${id}dot`} cx="0.38" cy="0.32" r="0.75">
      <stop offset="0" stop-color="#B5D0FF" /><stop offset="0.45" stop-color="#5B8CFF" /><stop offset="1" stop-color="#2D57E6" />
    </radialGradient>
  </defs>
  <rect x="100" y="100" width="824" height="824" rx="186" fill={`url(#${id}bg)`} />
  <rect x="102" y="102" width="820" height="820" rx="184" fill="none" stroke="#fff" stroke-opacity="0.14" stroke-width="4" />
  <g fill="none" stroke="#fff" stroke-width="50" stroke-linecap="round" stroke-linejoin="round">
    <path d="M282 410 V336 a54 54 0 0 1 54 -54 H410" /><path d="M614 282 H688 a54 54 0 0 1 54 54 V410" />
    <path d="M742 614 V688 a54 54 0 0 1 -54 54 H614" /><path d="M410 742 H336 a54 54 0 0 1 -54 -54 V614" />
  </g>
  <circle cx="512" cy="512" r="92" fill={`url(#${id}dot)`} />
</svg>
