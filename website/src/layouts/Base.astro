---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, OG_LOCALE, type Locale, type PageId } from '../i18n/locales';
import { t } from '../i18n';
import { href, pageHref } from '../lib/paths';

interface Props {
  locale: Locale;
  page: PageId;
  title: string;
  description: string;
  /** Extra preload for the first-fold image. */
  preload?: { href: string; type: string; srcset?: string; sizes?: string } | undefined;
}
const { locale, page, title, description, preload } = Astro.props;
const m = t(locale);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).toString();
const canonical = abs(pageHref(page, locale));
const ogImage = abs(href(`/og/${locale}.png`));
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(pageHref(page, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pageHref(page, 'en'))} />
    <meta name="theme-color" content="#04060c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FrameLy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.meta.ogAlt} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preload && <link rel="preload" as="image" href={preload.href} type={preload.type} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">{m.a11y.skip}</a>
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} year={year} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
