{
  "name": "framely",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "tauri": "tauri",
    "app:mac": "./scripts/macos-dev-app.sh",
    "check:windows": "cd src-tauri && cargo clippy --target x86_64-pc-windows-gnu --all-targets -- -D warnings",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "llm:build": "./scripts/build-llm-worker.sh"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
