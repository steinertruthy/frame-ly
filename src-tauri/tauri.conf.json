{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameLy",
  "version": "0.3.0",
  "identifier": "app.framely.desktop",
  "build": {
    "beforeDevCommand": "pnpm llm:build && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm llm:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost framely: http://framely.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Screen recording and screenshots",
    "copyright": "© 2026 FrameLy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "PortugueseBR",
          "Spanish",
          "French",
          "German"
        ],
        "customLanguageFiles": {
          "English": "installer/lang/English.nsh",
          "PortugueseBR": "installer/lang/PortugueseBR.nsh",
          "Spanish": "installer/lang/Spanish.nsh",
          "French": "installer/lang/French.nsh",
          "German": "installer/lang/German.nsh"
        },
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi"
      }
    },
    "externalBin": [
      "binaries/framely-llm"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFOUNCOUUzNjMyNDBENjQKUldSa0RTUmo0N21jTHJpMEdBNGJRTGRkNFhIL3pWL2NlcjQ4MG5LY0ovdG41cFZBMUM0Tm1Id0EK",
      "endpoints": [
        "https://github.com/steinertruthy/frame-ly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
