{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "Selection overlays, countdown, region frame and the post-capture preview",
  "windows": [
    "overlay-*",
    "preview",
    "countdown",
    "rec-frame",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-hide"
  ]
}
