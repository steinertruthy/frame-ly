<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements. Tauri signs with the Hardened Runtime (required for
  notarization); under it, protected resources need an explicit entitlement or macOS denies
  them silently — no prompt, and the app never appears in System Settings › Privacy.
  Screen Recording needs no entitlement (it's governed by TCC alone).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
